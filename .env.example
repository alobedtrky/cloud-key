PORT=3000
NODE_ENV=production

ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-12-plus-characters
SESSION_SECRET=replace-with-32-plus-random-characters

# Persistent storage (Render PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database
DATA_ENCRYPTION_KEY=replace-with-32-plus-random-characters
PGSSL=require

# Firebase Authentication
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Moyasar payments
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
MOYASAR_STC_PAY=false
MOYASAR_APPLE_PAY=false
